{
  "name": "@haridevx/hdx-css",
  "version": "0.1.0",
  "description": "HDX CSS — Modern utility-first CSS framework with design system",
  "type": "module",
  "main": "./src/index.js",
  "bin": {
    "hdx_css": "./src/cli/index.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./css": "./dist/hdx.css"
  },
  "files": [
    "src/",
    "dist/"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node src/cli/index.js build",
    "build:dev": "node src/cli/index.js build",
    "dev": "node src/cli/index.js watch",
    "generate": "node src/cli/index.js generate",
    "init": "node src/cli/index.js init"
  },
  "keywords": [
    "css",
    "utility",
    "framework",
    "design-system",
    "hdx",
    "tailwind"
  ],
  "author": "HariDevX",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^3.6.0",
    "commander": "^12.0.0",
    "fast-glob": "^3.3.0",
    "picocolors": "^1.0.0"
  },
  "devDependencies": {
    "vitest": "^2.0.0"
  }
}
